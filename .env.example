# Frontend Configuration
# URL of the WebSocket server for shared sessions
# For local development: ws://localhost:8080
# For Azure: wss://your-app.azurewebsites.net
# For Railway: wss://your-server.railway.app
VITE_WEBSOCKET_URL=ws://localhost:8080

# Enable or disable WebSocket functionality
# Set to 'false' to disable shared sessions and use localStorage only
VITE_ENABLE_WEBSOCKET=true

# Default session ID for development/testing (optional)
# Leave empty for random session generation
VITE_DEFAULT_SESSION_ID=

# Server Configuration (for WebSocket server)
# Port for WebSocket server
PORT=8080

# Enable session persistence (default: true)
# Set to 'false' to use memory-only storage
ENABLE_PERSISTENCE=true

# Storage type: 'memory', 'azure-table'
# Default: 'memory' (falls back if Azure credentials not provided)
STORAGE_TYPE=azure-table

# Azure Table Storage connection string (required for Azure persistence)
# Get from Azure Portal: Storage Account -> Access Keys
AZURE_STORAGE_CONNECTION_STRING=

# Session max duration in hours (default: 24)
SESSION_MAX_DURATION_HOURS=24
